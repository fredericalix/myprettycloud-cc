---
import { getEntry, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

const entry = await getEntry("docs", "introduction");
if (!entry) throw new Error("docs/introduction.md is missing");
const { Content } = await render(entry);
---

<DocsLayout title={entry.data.title} description={entry.data.description} slug="introduction" currentHref="/docs">
  <Content />
</DocsLayout>
