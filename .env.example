# --- Core ---
# Postgres connection (Clever Cloud injects POSTGRESQL_ADDON_URI in prod).
# Note: docker-compose maps Postgres to host port 5433 (avoids a local 5432).
DATABASE_URL=postgres://mpc:mpc@localhost:5433/myprettycloud
PORT=8080
APP_ENV=development

# Public URLs
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# AES-256-GCM key for OAuth tokens at rest: base64 of exactly 32 bytes.
# Generate: openssl rand -base64 32
# Required when APP_ENV=production. Omit in dev for a volatile random key.
ENCRYPTION_KEY=

# Clever Cloud OAuth 1.0a consumer credentials
CC_OAUTH_CONSUMER_KEY=
CC_OAUTH_CONSUMER_SECRET=

# --- Clever Cloud APIs (defaults are fine) ---
# CC_API_BASE_URL=https://api.clever-cloud.com
# WARP10_ENDPOINT=https://c2-warp10-clevercloud-customers.services.clever-cloud.com/api/v0/exec

# --- City realtime poller cadence (seconds) ---
WS_POLL_STATUS_SECS=10
WS_POLL_METRICS_SECS=15

# --- Webhooks (optional) ---
# WEBHOOKS_PUBLIC_URL=https://your-tunnel.example.com
# USE_WEBHOOKS=false

# --- Observability (optional, GlitchTip/Sentry) ---
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# DEBUG_CC_API=false

# --- Pulsar event bus (optional; alerting escalations + durable webhook inbox) ---
# PULSAR_URL=pulsar://localhost:6650
# PULSAR_TOKEN=
# PULSAR_NAMESPACE=

# --- Natural-language rule authoring via LM Studio (OpenAI-compatible) ---
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=local-model
# LMSTUDIO_API_KEY=          # usually empty for LM Studio

# --- SMTP notifications (optional) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=alerts@example.com
